# =============================================================================
# WalimApp — Repository .gitignore
# NEVER commit secrets, private keys, customer databases, or build artifacts.
# =============================================================================

# --- Secrets, Environment & Cryptographic Keys ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
service-account*.json
google-services.json

# --- WalimApp Licenses, Customer Backups & Local SQLite Databases ---
*.walimlic
*.walimbak
*.pre_restore
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# --- Flutter / Dart (apps/owner) ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
apps/owner/build/
apps/owner/.dart_tool/
apps/owner/android/.gradle/
apps/owner/android/captures/
apps/owner/android/local.properties
apps/owner/android/app/debug/
apps/owner/android/app/profile/
apps/owner/android/app/release/
apps/owner/windows/flutter/ephemeral/

# --- Laravel / PHP / Node (backend) ---
/vendor/
backend/vendor/
/node_modules/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
!backend/storage/app/public/
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
.phpunit.result.cache
.phpunit.cache/
Homestead.json
Homestead.yaml
auth.json

# --- Agent & Spec Kit Runtime Scratch (keep .agents/skills/ tracked!) ---
.agents/auth*
.agents/credentials*
.agents/*.token
.agents/cache/
.agents/logs/
.agents/tmp/

# --- IDEs & Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Artifacts ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.log
*.tmp
*.temp
